{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategic-context.schema.json",
  "title": "Strategic Context",
  "description": "Optional structured transcription of qualitative strategic context for a building or service point.",
  "type": "object",
  "required": ["strategic_context_id", "building_id", "transcription_date", "structured_summary"],
  "properties": {
    "strategic_context_id": {"type": "string"},
    "building_id": {"type": "string"},
    "service_point_id": {"type": ["string", "null"]},
    "transcription_date": {"type": "string"},
    "source_type": {"enum": ["meeting", "interview", "workshop", "site_discussion", "planning_note", "other"]},
    "source_reference": {"type": ["string", "null"]},
    "structured_summary": {"type": "string"},
    "strategic_intent": {"type": "array", "items": {"type": "string"}},
    "business_needs": {"type": "array", "items": {"type": "string"}},
    "known_constraints": {"type": "array", "items": {"type": "string"}},
    "known_dependencies": {"type": "array", "items": {"type": "string"}},
    "stakeholder_priorities": {"type": "array", "items": {"type": "string"}},
    "future_changes": {"type": "array", "items": {"type": "string"}},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "decision_signals": {"type": "array", "items": {"type": "string"}},
    "confidence": {"enum": ["low", "medium", "high", "unknown"]},
    "validated_by_human": {"type": "boolean"},
    "validation_date": {"type": ["string", "null"]},
    "source_system": {"type": ["string", "null"]},
    "source_record_id": {"type": ["string", "null"]}
  }
}