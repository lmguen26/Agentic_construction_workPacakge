{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "opportunities.schema.json",
  "title": "Normalized Opportunities",
  "type": "object",
  "required": ["site_id", "stage", "opportunities"],
  "properties": {
    "site_id": {"type": "string"},
    "stage": {"const": "OPPORTUNITIES"},
    "source_artifact": {"type": "string"},
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["opportunity_id", "source_deficiency_id", "title", "description"],
        "properties": {
          "opportunity_id": {"type": "string"},
          "source_deficiency_id": {"type": "string"},
          "title": {"type": "string"},
          "description": {"type": "string"},
          "system": {"type": ["string", "null"]},
          "location": {"type": ["string", "null"]},
          "priority": {"type": ["string", "null"]},
          "intervention_horizon_years": {"type": ["number", "null"]},
          "base_cost": {"type": ["number", "null"], "minimum": 0},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "assumptions": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
