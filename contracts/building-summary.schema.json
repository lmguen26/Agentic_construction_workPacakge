{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "building-summary.schema.json",
  "title": "Building Summary",
  "type": "object",
  "required": ["building_id", "stage", "executive_summary", "work_package_summary"],
  "properties": {
    "building_id": {"type": "string"},
    "site_id": {"type": ["string", "null"], "description": "Optional parent site identifier; never substitutes for building_id."},
    "stage": {"const": "SUMMARIZED"},
    "executive_summary": {"type": "string"},
    "work_package_summary": {"type": "array", "items": {"type": "object"}},
    "deferred_or_rejected_work_packages": {"type": "array", "items": {"type": "object"}},
    "major_cost_summary": {"type": ["object", "string", "null"]},
    "timing_summary": {"type": ["object", "string", "null"]},
    "key_dependencies": {"type": "array", "items": {"type": "string"}},
    "key_risks": {"type": "array", "items": {"type": "string"}},
    "key_decisions": {"type": "array", "items": {"type": "string"}},
    "unresolved_exceptions": {"type": "array", "items": {}},
    "human_reviews_required": {"type": "array", "items": {}},
    "data_quality_notes": {"type": "array", "items": {"type": "string"}},
    "source_artifact_version": {"type": ["string", "null"]},
    "model_metadata": {"type": "object"}
  },
  "additionalProperties": true
}
