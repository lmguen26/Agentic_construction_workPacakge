{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workpackages.schema.json",
  "title": "Draft Work Packages",
  "type": "object",
  "required": ["site_id", "stage", "work_packages"],
  "properties": {
    "site_id": {"type": "string"},
    "stage": {"const": "CLUSTERED"},
    "work_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["work_package_id", "title", "opportunity_ids", "rationale"],
        "properties": {
          "work_package_id": {"type": "string"},
          "title": {"type": "string"},
          "opportunity_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "bundle_type": {"enum": ["standalone", "bundle", "blend", "hybrid"]},
          "rationale": {"type": "string"},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "conflicts": {"type": "array", "items": {"type": "string"}},
          "assumptions": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
