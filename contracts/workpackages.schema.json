{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workpackages.schema.json",
  "title": "Draft Work Packages",
  "type": "object",
  "required": ["building_id", "stage", "work_packages"],
  "properties": {
    "building_id": {"type": "string"},
    "site_id": {"type": ["string", "null"], "description": "Optional parent site identifier; never substitutes for building_id."},
    "stage": {"const": "CLUSTERED"},
    "agent_version": {"type": "string"},
    "model_metadata": {"type": "object"},
    "rule_versions": {"type": "array", "items": {"type": "string"}},
    "work_packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["work_package_id", "title", "opportunity_ids", "rationale"],
        "properties": {
          "work_package_id": {"type": "string"},
          "title": {"type": "string"},
          "opportunity_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "source_deficiency_ids": {"type": "array", "items": {"type": "string"}},
          "cluster_ids": {"type": "array", "items": {"type": "string"}},
          "bundle_type": {"enum": ["standalone", "bundle", "blend", "hybrid"]},
          "rationale": {"type": "string"},
          "bundling_rationale": {"type": ["string", "null"]},
          "blending_rationale": {"type": ["string", "null"]},
          "proposed_scope": {"type": ["string", "null"]},
          "intervention_horizon": {"type": ["string", "null"]},
          "intervention_horizon_years": {"type": ["number", "null"], "minimum": 0},
          "base_cost": {"type": ["number", "null"], "minimum": 0},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "conflicts": {"type": "array", "items": {"type": "string"}},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "exceptions": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "stage_exceptions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
